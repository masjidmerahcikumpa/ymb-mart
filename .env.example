# ==============================================================================
# Baiturrahman Mart — Environment Configuration Template (.env.example)
# Salin file ini menjadi .env jika ingin menggunakan konfigurasi via Environment
# ==============================================================================

# Server Configuration
PORT=8070
APP_ENV=development

# Turso Cloud Database (libSQL)
# Dapatkan dari: https://turso.tech dashboard
TURSO_DATABASE_URL=libsql://ymb-mart-masjidmerahcikumpa.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_jwt_token_here

# Mode Cloudflared Tunnel (Opsional untuk Remote Testing Lokal)
# Ubah ke true jika ingin mengaktifkan tunnel publik cloudflared
ENABLE_ADMIN_TUNNEL=false

# Deployment Flag (Di-set otomatis oleh platform Vercel)
# VERCEL=1

